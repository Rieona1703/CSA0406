#include<stdio.h>

int main()
{
    int n,i,time=0,remain;
    int bt[20],rt[20],pr[20];

    printf("Enter number of processes: ");
    scanf("%d",&n);

    remain=n;

    for(i=0;i<n;i++)
    {
        printf("Burst Time P%d: ",i+1);
        scanf("%d",&bt[i]);

        printf("Priority: ");
        scanf("%d",&pr[i]);

        rt[i]=bt[i];
    }

    printf("\nExecution:\n");

    while(remain>0)
    {
        int highest=-1;

        for(i=0;i<n;i++)
        {
            if(rt[i]>0)
            {
                if(highest==-1 || pr[i]<pr[highest])
                    highest=i;
            }
        }

        printf("Time %d -> P%d\n",time,highest+1);

        rt[highest]--;

        time++;

        if(rt[highest]==0)
            remain--;
    }

    return 0;
}
