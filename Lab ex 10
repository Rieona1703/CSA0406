#include<stdio.h>
#include<sys/ipc.h>
#include<sys/msg.h>
#include<string.h>

struct msg
{
    long type;
    char text[100];
};

int main()
{
    struct msg message;

    key_t key=1234;

    int msgid=msgget(key,0666|IPC_CREAT);

    message.type=1;

    printf("Enter Message: ");
    scanf("%s",message.text);

    msgsnd(msgid,&message,sizeof(message.text),0);

    msgrcv(msgid,&message,sizeof(message.text),1,0);

    printf("Received: %s\n",message.text);

    return 0;
}
