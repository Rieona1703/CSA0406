#include <stdio.h>
#include <pthread.h>
#include <unistd.h>

#define N 5

pthread_mutex_t fork[N];

void *philosopher(void *arg)
{
    int i = *(int *)arg;

    printf("Philosopher %d is thinking\n", i + 1);

    pthread_mutex_lock(&fork[i]);
    pthread_mutex_lock(&fork[(i + 1) % N]);

    printf("Philosopher %d is eating\n", i + 1);
    sleep(1);

    pthread_mutex_unlock(&fork[(i + 1) % N]);
    pthread_mutex_unlock(&fork[i]);

    printf("Philosopher %d finished eating\n", i + 1);

    return NULL;
}

int main()
{
    pthread_t thread[N];
    int id[N];

    for (int i = 0; i < N; i++)
        pthread_mutex_init(&fork[i], NULL);

    for (int i = 0; i < N; i++)
    {
        id[i] = i;
        pthread_create(&thread[i], NULL, philosopher, &id[i]);
    }

    for (int i = 0; i < N; i++)
        pthread_join(thread[i], NULL);

    return 0;
}
